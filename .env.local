# ============================================================
# STEAMIFY - Environment Variables
# Bu fayl .gitignore ga qo'shilgan - git ga yuklanmaydi
# ============================================================

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Environment ---
NODE_ENV=development

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# --- Secrets (Production uchun o'zgartiring!) ---
# DATABASE_URL="postgresql://user:password@localhost:5432/steamify"
# JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
# ENCRYPTION_KEY="your-super-secret-encryption-key"
# NEXTAUTH_SECRET="your-nextauth-secret"
# NEXTAUTH_URL="https://steamify.uz"
